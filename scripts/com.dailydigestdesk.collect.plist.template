<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job: run desk-collect on weekdays before the market opens and after it closes.
  Don't load this file directly: scripts/install-schedule.sh fills in the __PLACEHOLDERS__
  for this Mac and installs the result in ~/Library/LaunchAgents/.

  Times are this Mac's local time. The installer converts 8:00am and 5:00pm New York
  (e.g. 6:00 and 15:00 in Denver). If the Mac is asleep at that time, launchd runs the
  job when it wakes up.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dailydigestdesk.collect</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_DIR__/scripts/run-digest.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>DESK_COLLECT</key>
        <string>__DESK_COLLECT__</string>
    </dict>

    <!-- Weekday 1 = Monday ... 5 = Friday. Weekend news lands on Monday's morning page. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>__MORNING_HOUR__</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>__MORNING_HOUR__</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>__MORNING_HOUR__</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>__MORNING_HOUR__</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>__MORNING_HOUR__</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>__EVENING_HOUR__</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>__EVENING_HOUR__</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>__EVENING_HOUR__</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>__EVENING_HOUR__</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>__EVENING_HOUR__</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <!-- run-digest.sh logs desk-collect itself; this catches the script's own errors. -->
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/data/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/data/logs/launchd.log</string>
</dict>
</plist>
