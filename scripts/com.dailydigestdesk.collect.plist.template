<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job: check every 15 minutes whether a desk-collect run is due, and run it if so.
  Don't load this file directly: scripts/install-schedule.sh fills in the __PLACEHOLDERS__
  for this Mac and installs the result in ~/Library/LaunchAgents/.

  Runs are due at 8:00am and 5:00pm New York on weekdays, but desk-collect decides
  that itself (its if-due flag; daily_digest_desk/schedule.py), not launchd. launchd's
  calendar times (StartCalendarInterval) skipped runs the Mac slept through, so instead
  it asks often, and a missed slot runs at the next check the Mac is awake for.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dailydigestdesk.collect</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_DIR__/scripts/run-digest.sh</string>
        <string>--if-due</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>DESK_COLLECT</key>
        <string>__DESK_COLLECT__</string>
    </dict>

    <!-- Every 15 minutes (900 seconds). Almost every check finds nothing due and
         stops in about a second, with no log entry or pop-up (run-digest.sh). -->
    <key>StartInterval</key>
    <integer>900</integer>

    <!-- Check once when the job loads too (installing it, or logging in), not only
         15 minutes later. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- run-digest.sh shows its pop-up in the background and ends without waiting
         for a click. By default launchd closes everything a job started when the
         job ends, which would close the pop-up too; this leaves it open. -->
    <key>AbandonProcessGroup</key>
    <true/>

    <!-- run-digest.sh logs desk-collect itself; this catches the script's own errors. -->
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/data/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/data/logs/launchd.log</string>
</dict>
</plist>
